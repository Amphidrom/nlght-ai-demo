<Project Sdk="Microsoft.NET.Sdk">
  <!--
    nlght-ai Among Us bridge: a BepInEx 6 (IL2CPP) + Reactor plugin that speaks
    protocol v1 (among_us/protocol.py) to the Python match orchestrator.

    UNVERIFIED: package versions must match the installed Among Us build.
    Check them on Windows before the first build (see README.md, step 1).
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>NlghtAmongUsBridge</AssemblyName>
    <RootNamespace>Nlght.AmongUs.Bridge</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Path to the game install, e.g. "C:\Program Files (x86)\Steam\steamapps\common\Among Us". -->
    <AmongUsPath Condition="'$(AmongUsPath)' == ''">$(AMONG_US)</AmongUsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- TODO(verify): BepInEx 6 bleeding-edge build that Reactor targets. -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" Private="false" ExcludeAssets="runtime;native" />
    <!-- TODO(verify): Reactor release compatible with the game version. -->
    <PackageReference Include="Reactor" Version="2.*" Private="false" />
    <!-- TODO(verify): generated game assemblies for the exact Among Us build (Steam or Epic). -->
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(AmongUsPath)' != ''">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(AmongUsPath)/BepInEx/plugins/" />
  </Target>
</Project>
